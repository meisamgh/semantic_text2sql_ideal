TEXT2SQL_DATABASE_ROOT=data
TEXT2SQL_PROFILE_ROOT=profiles
TEXT2SQL_WORKSPACES_PATH=data/workspaces.json
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org
POSTGRES_BOOKS_DSN=postgresql://text2sql_reader:change-me@127.0.0.1:5432/text2sql_books
# Enable Context Planner call 1. It uses the provider/model selected by the user.
TEXT2SQL_CONTEXT_PLANNER_ENABLED=true
# Empty means use the provider/model selected by the user for both bounded calls.
TEXT2SQL_CONTEXT_MODEL=
TEXT2SQL_SQL_MODEL=
# Historical examples default to zero. Enable only after a paired benchmark proves benefit.
TEXT2SQL_HISTORY_ENABLED=false
TEXT2SQL_HISTORY_PATH=data/bird_history_seed42_400.json
TEXT2SQL_HISTORY_MIN_SCORE=0.85
