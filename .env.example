TEXT2SQL_DATABASE_ROOT=data
# Optional MySQL, SQL Server, Snowflake and BigQuery connections (lazy-loaded).
# See docs/EXTERNAL_DATABASES.md. URLs/credentials remain in referenced env variables.
TEXT2SQL_EXTERNAL_CONNECTIONS=[]
# Approved metric definitions and business terminology (JSON directory).
TEXT2SQL_GLOSSARY_ROOT=data/business_glossaries
# Database used by the web app. It must exist under TEXT2SQL_DATABASE_ROOT
# or in the configured PostgreSQL/external allowlist.
TEXT2SQL_DEFAULT_DB_ID=debit_card_specializing
# V6.2 assistant is optional for existing installations; when enabled its
# final client-facing prose comes from the selected assistant model.
TEXT2SQL_CONVERSATIONAL_BRIDGE_ENABLED=false
TEXT2SQL_CONVERSATIONAL_AGENT_ENABLED=true
TEXT2SQL_PLOTTING_PROVIDER=
TEXT2SQL_PLOTTING_MODEL=
# Optional dashboard designer. Configure a registered provider/model for the
# explicit "AI design" UI action; conversational design defaults to the assistant.
# Empty UI configuration uses the deterministic Phase 1 fallback.
TEXT2SQL_DASHBOARD_PROVIDER=
TEXT2SQL_DASHBOARD_MODEL=
TEXT2SQL_DASHBOARD_MAX_TOKENS=1536
TEXT2SQL_ASSISTANT_TIMEOUT_SECONDS=180
# Shared ceiling includes Top decisions, governed SQL and at most one dashboard correction.
TEXT2SQL_ASSISTANT_MAX_MODEL_CALLS=12
TEXT2SQL_ASSISTANT_MAX_DATABASE_CALLS=24
TEXT2SQL_STRUCTURED_MAX_COMPLETION_TOKENS=1536
# Groq/Qwen task budgets. JSON-mode decision fallback uses these, never the old 180-token cap.
TEXT2SQL_TOP_DECISION_MAX_TOKENS=1536
TEXT2SQL_TOP_REPAIR_MAX_TOKENS=2048
TEXT2SQL_TOP_ANSWER_MAX_TOKENS=1536
TEXT2SQL_CONTEXT_MAX_TOKENS=1536
TEXT2SQL_SQL_MAX_TOKENS=2048
TEXT2SQL_PLOTTING_MAX_TOKENS=1536
TEXT2SQL_MAX_COMPLETION_TOKENS=2048
TEXT2SQL_EMBEDDING_PRELOAD=true
TEXT2SQL_EMBEDDING_STARTUP_TIMEOUT_SECONDS=15
TEXT2SQL_GZIP_ENABLED=true
TEXT2SQL_GZIP_MIN_BYTES=2048
TEXT2SQL_GZIP_LEVEL=5
# Optional independent orchestration model; defaults to selected request provider/model.
# TEXT2SQL_ASSISTANT_PROVIDER=agentrouter
# TEXT2SQL_ASSISTANT_MODEL=claude-opus-5
# Local understanding/orchestration alternative:
# TEXT2SQL_ASSISTANT_PROVIDER=ollama
# TEXT2SQL_ASSISTANT_MODEL=gemma4:12b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=16384
# Optional independent recovery reasoning model; SQL repair still uses the SQL provider.
# TEXT2SQL_RECOVERY_PROVIDER=groq
# TEXT2SQL_RECOVERY_MODEL=qwen/qwen3.8-27b
TEXT2SQL_PROFILE_ROOT=profiles
TRUE_SOTA_API_KEY=
TRUE_SOTA_BASE_URL=https://true-sota.com
TRUE_SOTA_TIMEOUT_SECONDS=180
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org
AGENTROUTER_TIMEOUT_SECONDS=180
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=180
JUSTDOWORK_API_KEY=
JUSTDOWORK_BASE_URL=
JUSTDOWORK_TIMEOUT_SECONDS=120
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
CODECRAFT_TIMEOUT_SECONDS=120
# Optional microphone input. Use a key and Chat Completions workspace URL from the same region.
# Example URL: https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_AUDIO_API_KEY=
QWEN_AUDIO_BASE_URL=
QWEN_AUDIO_MODEL=qwen3.8-omni-flash
QWEN_AUDIO_TIMEOUT_SECONDS=60
# If Qwen audio is not configured, the existing GROQ_API_KEY is used for
# whisper-large-v3-turbo transcription. No separate speech key is required.
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_AUDIO_TIMEOUT_SECONDS=60
POSTGRES_BOOKS_DSN=postgresql://text2sql_reader:change-me@127.0.0.1:5432/text2sql_books
# Multiple allowlisted PostgreSQL databases (JSON object). Prefer a read-only database role.
# TEXT2SQL_POSTGRES_DATABASES={"business":"postgresql://reader:change-me@127.0.0.1:5432/business"}
# Shared retrieval path for both A/B modes.
TEXT2SQL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEXT2SQL_RETRIEVAL_TABLES=5
TEXT2SQL_RETRIEVAL_COLUMNS=5
TEXT2SQL_SCHEMA_RERANKER_ENABLED=true
TEXT2SQL_SCHEMA_RERANKER_MODEL=models/schema_reranker/v1/model.txt
TEXT2SQL_SCHEMA_RERANKER_POOL=30
# Server-side model choices for the web UI and API. No model controls appear in the composer.
TEXT2SQL_SQL_PROVIDER=groq
TEXT2SQL_CONTEXT_MODE=model1
TEXT2SQL_CONTEXT_PROVIDER=groq
TEXT2SQL_CONTEXT_MODEL=qwen/qwen3.8-27b
TEXT2SQL_SQL_MODEL=qwen/qwen3.8-27b
# Historical examples default to zero. Enable only after a paired benchmark proves benefit.
TEXT2SQL_HISTORY_ENABLED=false
TEXT2SQL_HISTORY_PATH=benchmarks/data/bird_history_seed42_400.json
TEXT2SQL_HISTORY_MIN_SCORE=0.85
TEXT2SQL_HISTORY_ML_MIN_SCORE=0.65
# One end-to-end request budget shared by retrieval, models, recovery, and execution.
TEXT2SQL_REQUEST_TIMEOUT_SECONDS=180
TEXT2SQL_REQUEST_MAX_MODEL_CALLS=6
TEXT2SQL_REQUEST_MAX_DATABASE_CALLS=24
# Durable, versioned conversation state supports follow-ups after an API restart.
# Set blank only if losing accepted state on restart is acceptable.
TEXT2SQL_CONVERSATION_STORE=data/runtime/conversations.sqlite
TEXT2SQL_CONVERSATION_TTL_SECONDS=86400
# Durable conversation turns and bounded result previews. Use :memory: to disable persistence.
TEXT2SQL_RUN_HISTORY_PATH=data/runtime/query_history.sqlite
# Permanent Dashboard Studio reuses this file; :memory: disables permanent saves.
# Single-user local access only. Set false before any proxy/shared deployment;
# remote use requires trusted ASGI authentication and session ownership binding.
# External dashboard sharing is intentionally not implemented/enabled.
TEXT2SQL_DASHBOARD_LOCAL_WORKSPACE=true
TEXT2SQL_JOB_TTL_SECONDS=3600
TEXT2SQL_MAX_JOBS=500
# --- Conversational analytics planner ----------------------------------------
# Deterministic analytics planning + the Result Reusability Gate (reuse /
# requery / clarify for visualization follow-ups).
TEXT2SQL_ANALYTICS_PLANNER_ENABLED=true
# Optional, flag-gated LLM refinement of AMBIGUOUS plans only. Model output is
# re-validated and schema/metric-gated; any failure falls back to the
# deterministic plan. Obvious chart mechanics never reach the model.
TEXT2SQL_ANALYTICS_PLANNER_LLM_ENABLED=false
# Optional local JSONL path for per-turn planner decision/latency records
# (also visible at GET /api/analytics-metrics). Leave blank to keep in memory.
TEXT2SQL_ANALYTICS_METRICS_PATH=
# Optional LLM candidate generation for chart recommendations. Structured
# proposals are re-validated through the deterministic chart planner before
# display; on any failure the deterministic ranking stays authoritative.
TEXT2SQL_VIZ_RECOMMENDER_LLM_ENABLED=true

# Administrative only. Keep false in normal deployments; /api/chat is the governed path.
TEXT2SQL_ENABLE_ADMIN_CHECK_EXECUTION=false
# History retains bounded UI previews, not full result sets. Use 0 for SQL-only retention.
TEXT2SQL_HISTORY_PREVIEW_ROWS=20
