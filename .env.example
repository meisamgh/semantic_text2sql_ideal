TEXT2SQL_DATABASE_ROOT=data
TEXT2SQL_PROFILE_ROOT=profiles
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
POSTGRES_BOOKS_DSN=postgresql://text2sql_reader:change-me@127.0.0.1:5432/text2sql_books
# Multiple allowlisted PostgreSQL databases (JSON object). Prefer a read-only database role.
# TEXT2SQL_POSTGRES_DATABASES={"business":"postgresql://reader:change-me@127.0.0.1:5432/business"}
# Shared retrieval path for both A/B modes.
TEXT2SQL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TEXT2SQL_RETRIEVAL_TABLES=5
TEXT2SQL_RETRIEVAL_COLUMNS=5
TEXT2SQL_SCHEMA_RERANKER_ENABLED=true
TEXT2SQL_SCHEMA_RERANKER_MODEL=models/schema_reranker/v1/model.txt
TEXT2SQL_SCHEMA_RERANKER_POOL=30
# Optional API-side model overrides; the web selectors take precedence.
TEXT2SQL_CONTEXT_MODEL=
TEXT2SQL_SQL_MODEL=
# Historical examples default to zero. Enable only after a paired benchmark proves benefit.
TEXT2SQL_HISTORY_ENABLED=false
TEXT2SQL_HISTORY_PATH=benchmarks/data/bird_history_seed42_400.json
TEXT2SQL_HISTORY_MIN_SCORE=0.85
TEXT2SQL_HISTORY_ML_MIN_SCORE=0.65
